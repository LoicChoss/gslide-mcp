  "text_rules": {
    "min_size": 11,
    "small_min_size": 10,
    "small_styles": [
      "caption",
      "card_label",
      "badge",
      "kpi_delta",
      "chart_label",
      "chart_value",
      "axis",
      "legend",
      "pill",
